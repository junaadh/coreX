macro passthrough {
	rule (input: Expr) => { input };
}
/// a
enum TokenKind {
	Slash,
	Star,
	LParen,

	fn is_star(&self) -> bool {
		self == .Star
	}
}

fn main() {
	let a = @passthrough(1);
	var b = @passthrough(true);
	let c = @passthrough("Hello");
	let d = @passthrough(@passthrough(a) == 1 == @passthrough(b));
	// Mutability violation
	// a = 2;
	// Type mismatch
	// b = 1;
	b = false;

	var a = TokenKind.Slash;
	a = .Star;
	let b = .LParen;
	let is_star = a.is_star();
}
