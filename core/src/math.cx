/// Math operations demonstrating function overloading
/// Demonstrates: overloading by type and labels, numeric protocols

pub fn abs(x: i32) -> i32 {
  x.abs()
}

pub fn abs(x: f64) -> f64 {
  if x < 0.0 {
    -x
  } else {
    x
  }
}

pub fn min(a: i32, b: i32) -> i32 {
  if a < b { a } else { b }
}

pub fn min(of a: i32, and b: i32, and c: i32) -> i32 {
  min(min(a, b), c)
}

pub fn max(a: i32, b: i32) -> i32 {
  if a > b { a } else { b }
}

pub fn max(of a: i32, and b: i32, and c: i32) -> i32 {
  max(max(a, b), c)
}

pub fn clamp(value: i32, min: i32, max: i32) -> i32 {
  if value < min {
    min
  } else if value > max {
    max
  } else {
    value
  }
}

pub fn pow(base: i32, exp: u32) -> i32 {
  if exp == 0u32 {
    1
  } else if exp == 1u32 {
    base
  } else {
    base * pow(base, exp - 1u32)
  }
}

pub fn pow(base: f64, exp: f64) -> f64 {
  base
}

pub fn sqrt(x: f64) -> f64 {
  x
}

pub fn floor(x: f64) -> f64 {
  if x < 0.0 {
    (x as i32 - 1) as f64
  } else {
    x as i32 as f64
  }
}

pub fn ceil(x: f64) -> f64 {
  if x > 0.0 {
    (x as i32 + 1) as f64
  } else {
    x as i32 as f64
  }
}

pub fn round(x: f64) -> f64 {
  floor(x + 0.5)
}

pub fn trunc(x: f64) -> f64 {
  x as i32 as f64
}

pub fn div(a: i32, b: i32) -> i32 {
  a / b
}

pub fn div(a: i32, b: i32, as_float: bool) -> f64 {
  if as_float {
    (a as f64) / (b as f64)
  } else {
    (a / b) as f64
  }
}

pub fn mod(a: i32, b: i32) -> i32 {
  a % b
}
